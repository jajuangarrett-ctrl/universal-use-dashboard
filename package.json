{
  "name": "universal-use-dashboard",
  "version": "0.2.0",
  "private": true,
  "description": "Portable folder dashboards for Obsidian Bases",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "install:vault": "node scripts/install.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
